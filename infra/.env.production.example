COMPOSE_PROJECT_NAME=saas_vendas_prod
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.seudominio.com
FRONTEND_URL=https://app.seudominio.com
CORS_ALLOWED_ORIGINS=https://app.seudominio.com
VITE_API_BASE_URL=https://app.seudominio.com/api/v1
HTTP_PORT=80
HTTPS_PORT=443
LOG_LEVEL=warning
DB_PASSWORD=use-strong-password-vault
REDIS_PASSWORD=use-strong-redis-password
JWT_SECRET=use-jwt-secret-from-vault
QUEUE_WORKERS=4
BACKUP_RETENTION_DAYS=30
API_BUILD_TARGET=production
API_PATH=../../saas_vendas_api
WEB_PATH=..
