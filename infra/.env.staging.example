COMPOSE_PROJECT_NAME=saas_vendas_staging
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.seudominio.com
FRONTEND_URL=https://staging.seudominio.com
CORS_ALLOWED_ORIGINS=https://staging.seudominio.com
VITE_API_BASE_URL=https://staging.seudominio.com/api/v1
HTTP_PORT=8080
LOG_LEVEL=info
DB_PASSWORD=staging-db-password-change-me
REDIS_PASSWORD=staging-redis-password
JWT_SECRET=generate-strong-secret
QUEUE_WORKERS=2
API_BUILD_TARGET=production
API_PATH=../../saas_vendas_api
WEB_PATH=..
