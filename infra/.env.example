# =============================================================================
# SaaS Vendas — variáveis de infraestrutura (copie para .env)
# =============================================================================

COMPOSE_PROJECT_NAME=saas_vendas

# Caminhos dos repositórios (irmãos em htdocs)
API_PATH=../../saas_vendas_api
WEB_PATH=..

# Ambiente: local | staging | production
APP_ENV=local

# Gateway HTTP(S)
# Com XAMPP no Windows, a porta 80 e usada pelo Apache — use 8080 (ou outra livre).
HTTP_PORT=8080
HTTPS_PORT=443
DOMAIN=localhost

# API Laravel (dev: chaves ficam em saas_vendas_api/.env — gere com setup.ps1)
# Staging/prod: preencha APP_KEY e JWT_SECRET aqui
# APP_KEY=
# JWT_SECRET=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Build do frontend (URL pública da API no browser)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=SaaS Vendas

# PostgreSQL
DB_DATABASE=saas_vendas
DB_USERNAME=saas
DB_PASSWORD=change-me-in-production
DB_PUBLISH_PORT=5433

# Redis
REDIS_PASSWORD=
REDIS_PUBLISH_PORT=6379

# Filas — réplicas em produção (docker compose --scale queue=N)
QUEUE_WORKERS=2

# Backup (retenção em dias)
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE=0 3 * * *

# Observabilidade (profile: observability)
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# Staging / Production
# APP_DEBUG=false
# LOG_LEVEL=warning
# REDIS_PASSWORD=strong-redis-password
